import { Palette } from "std-widgets.slint";
import {
    MaterialPalette,
    MaterialTypography,
    MaterialAnimations,
    MaterialText,
    Slider,
    Switch,
    FilledButton,
    TextButton,
    ListView,
} from "@material";
import { Skin } from "skin.slint";

export struct ThemeCard {
    name: string,
    meta: string,
    tile: image,
    has-tile: bool,
}

// ---------------------------------------------------------------- pieces ---

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> open;
    in property <length> box: 36px;
    in property <string> tip;
    callback clicked;

    width: box;
    height: box;
    border-radius: box / 2;
    background: open ? Skin.a.container : (touch.has-hover ? Skin.state-layer : transparent);
    animate background { duration: 120ms; easing: MaterialAnimations.standard-easing; }

    accessible-role: button;
    accessible-label: tip;
    accessible-action-default => { root.clicked(); }

    Image {
        source: root.icon;
        width: 18px;
        height: 18px;
        colorize: root.open ? Skin.a.on-container : Skin.on-surface-variant;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component WindowButton inherits Rectangle {
    in property <image> icon;
    in property <bool> danger;
    in property <string> tip;
    callback clicked;

    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: danger ? Skin.error-container : Skin.state-layer;
    opacity: touch.has-hover ? 1.0 : 0.85;

    accessible-role: button;
    accessible-label: tip;
    accessible-action-default => { root.clicked(); }

    Image {
        source: root.icon;
        width: 14px;
        height: 14px;
        colorize: root.danger ? Skin.on-error-container : Skin.on-surface;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The handoff's chip: 1px outline, radius 9, and a primary-container fill
// behind the label when selected. Deliberately not the library FilterChip,
// which carries a check icon and a different radius.
component Chip inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled;

    height: 28px;
    border-radius: 9px;
    border-width: 1px;
    border-color: checked ? transparent : Skin.chip-border;
    background: checked ? Skin.a.container : (touch.has-hover ? Skin.state-layer : transparent);
    animate background { duration: 120ms; easing: MaterialAnimations.standard-easing; }

    accessible-role: button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggle(); }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 500;
            color: root.checked ? Skin.a.on-container : Skin.on-surface;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }

    function toggle() {
        root.checked = !root.checked;
        root.toggled();
    }
}

component Tick inherits Rectangle {
    in property <int> value;
    in property <bool> current;
    callback clicked;

    height: 30px;
    border-radius: 10px;
    background: current ? Skin.a.container : Skin.container;
    animate background { duration: 120ms; easing: MaterialAnimations.standard-easing; }

    accessible-role: button;
    accessible-label: root.value + " pixels";
    accessible-action-default => { root.clicked(); }

    Text {
        text: root.value;
        font-family: "Roboto Mono";
        font-size: 12px;
        color: root.current ? Skin.a.on-container : Skin.on-surface;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ThemeRow inherits Rectangle {
    in property <ThemeCard> card;
    in property <bool> selected;
    callback clicked;

    height: 64px;
    border-radius: 16px;
    background: touch.has-hover ? Skin.state-layer : transparent;

    accessible-role: button;
    accessible-label: root.card.name + ", " + root.card.meta;
    accessible-action-default => { root.clicked(); }

    // The selected fill sits behind the content, per the handoff.
    if root.selected: Rectangle {
        border-radius: parent.border-radius;
        background: Skin.a.container;
        opacity: 0.6;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;

        // Preview tile: the theme's own pointer, rasterized.
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: Skin.dark ? #0e1116 : #ffffff;
            border-width: 1px;
            border-color: Skin.hairline;
            clip: true;
            if root.card.has-tile: Image {
                source: root.card.tile;
                image-fit: contain;
                image-rendering: smooth;
                width: 30px;
                height: 30px;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.card.name;
                font-size: 14px;
                font-weight: 500;
                color: Skin.on-surface;
                overflow: elide;
            }
            Text {
                text: root.card.meta;
                font-size: 11.5px;
                color: Skin.on-surface-variant;
                overflow: elide;
            }
        }

        Rectangle { }

        VerticalLayout {
            alignment: center;
            if root.selected: Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: Skin.a.primary;
                Image {
                    source: @image-url("icons/check.svg");
                    width: 12px;
                    height: 12px;
                    colorize: Skin.a.on-primary;
                }
            }
        }
    }
}

component PreviewShape inherits Rectangle {
    in property <image> source;
    in property <bool> present;
    in property <length> box;

    width: box;
    height: box;
    if present: Image {
        source: root.source;
        image-fit: contain;
        image-rendering: smooth;
        width: 100%;
        height: 100%;
    }
    // A shape the theme does not define, marked rather than left as a hole.
    if !present: Rectangle {
        width: 14px;
        height: 2px;
        border-radius: 1px;
        background: Skin.on-surface-variant.with-alpha(0.5);
    }
}

// ------------------------------------------------------------------ app ---

export component AppWindow inherits Window {
    title: "optination — cursor themes";
    no-frame: true;
    background: transparent;
    preferred-width: 1000px;
    preferred-height: 640px;
    min-width: 880px;
    min-height: 560px;
    default-font-family: "Roboto";

    in property <[ThemeCard]> cards;
    in property <int> total;
    in property <string> command;
    in property <string> status;
    in property <bool> status-is-error;
    in property <string> stale-conf;
    in property <bool> can-revert;
    in property <string> sel-name;
    in property <image> dots;

    in property <image> sel-p0;
    in property <image> sel-p1;
    in property <image> sel-p2;
    in property <image> sel-p3;
    in property <image> sel-p4;
    in property <image> sel-p5;
    in property <bool> sel-h0;
    in property <bool> sel-h1;
    in property <bool> sel-h2;
    in property <bool> sel-h3;
    in property <bool> sel-h4;
    in property <bool> sel-h5;

    in-out property <int> selected: -1;
    in-out property <float> size: 32;
    in-out property <string> filter;
    in-out property <int> backdrop-mode: 0;
    in-out property <bool> dark: true;
    in-out property <int> accent: 0;
    in-out property <bool> menu-open: false;
    in-out property <bool> follow-theme: false;

    in-out property <bool> f-x11;
    in-out property <bool> f-hypr;
    in-out property <bool> f-light;
    in-out property <bool> f-dark;
    in-out property <bool> f-standard;
    in-out property <bool> f-mirrored;
    in-out property <bool> f-system;
    in-out property <bool> f-user;

    callback select(int);
    callback size-changed(int);
    callback filter-changed(string);
    callback filters-changed();
    callback save();
    callback revert();
    callback close-window();
    callback minimize-window();
    callback maximize-window();
    callback mode-changed();
    callback follow-theme-changed(bool);

    // Preview backdrop stays separate from the app mode: a white cursor on a
    // dark panel and a black one on a light panel are equally invisible.
    property <color> backdrop:
        backdrop-mode == 0 ? #121215 :
        backdrop-mode == 1 ? #fbfbfd : #8a8d94;

    public function sync-skin() {
        Skin.accent = root.accent;
        Skin.dark = root.dark;
        MaterialPalette.schemes = Skin.schemes;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }

    init => { root.sync-skin(); }

    // Window body. The radius is drawn here because the window itself is
    // frameless.
    Rectangle {
        border-radius: 28px;
        background: Skin.surface;
        clip: true;

        VerticalLayout {
            // ----------------------------------------------- title bar ---
            Rectangle {
                height: 66px;
                background: Skin.container;

                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 20px;
                    padding-top: 16px;
                    padding-bottom: 14px;
                    spacing: 12px;

                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 12px;
                        background: Skin.a.container;
                        Image {
                            source: @image-url("icons/pointer.svg");
                            width: 18px;
                            height: 18px;
                            colorize: Skin.a.on-container;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "Cursor";
                            font-size: 20px;
                            font-weight: 500;
                            letter-spacing: 0.1px;
                            color: Skin.on-surface;
                        }
                        Text {
                            text: "Appearance · Pointer";
                            font-size: 12px;
                            color: Skin.on-surface-variant;
                        }
                    }

                    Rectangle { }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;

                        IconButton {
                            icon: @image-url("icons/palette.svg");
                            open: root.menu-open;
                            tip: "Accent colour";
                            clicked => { root.menu-open = !root.menu-open; }
                        }

                        IconButton {
                            icon: root.dark ? @image-url("icons/moon.svg")
                                : @image-url("icons/sun.svg");
                            tip: root.dark ? "Switch to light" : "Switch to dark";
                            clicked => {
                                root.dark = !root.dark;
                                root.sync-skin();
                                root.mode-changed();
                            }
                        }

                        Rectangle { width: 10px; }

                        WindowButton {
                            icon: @image-url("icons/minimize.svg");
                            tip: "Minimise";
                            clicked => { root.minimize-window(); }
                        }
                        WindowButton {
                            icon: @image-url("icons/maximize.svg");
                            tip: "Maximise";
                            clicked => { root.maximize-window(); }
                        }
                        WindowButton {
                            icon: @image-url("icons/close.svg");
                            danger: true;
                            tip: "Close";
                            clicked => { root.close-window(); }
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Skin.hairline;
                }
            }

            // ---------------------------------------------------- body ---
            HorizontalLayout {
                // ----------------------------------------- left pane ---
                Rectangle {
                    width: 392px;
                    background: Skin.pane;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 14px;

                        // Search
                        Rectangle {
                            height: 48px;
                            border-radius: 24px;
                            background: Skin.container-high;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("icons/search.svg");
                                        width: 18px;
                                        height: 18px;
                                        colorize: Skin.on-surface-variant;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    input := TextInput {
                                        text <=> root.filter;
                                        font-size: 14px;
                                        color: Skin.on-surface;
                                        single-line: true;
                                        vertical-alignment: center;
                                        accessible-label: "Search cursor themes";
                                        edited => { root.filter-changed(self.text); }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.cards.length + " themes";
                                        font-family: "Roboto Mono";
                                        font-size: 11px;
                                        color: Skin.on-surface-variant;
                                    }
                                }
                            }

                            // TextInput has no placeholder of its own.
                            if root.filter == "": Text {
                                x: 44px;
                                text: "Search cursor themes";
                                font-size: 14px;
                                color: Skin.on-surface-variant;
                                vertical-alignment: center;
                                height: 100%;
                            }
                        }

                        // Filter chips, in the app's real groups.
                        VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Chip { text: "X11"; checked <=> root.f-x11; toggled => { root.filters-changed(); } }
                                Chip { text: "hyprcursor"; checked <=> root.f-hypr; toggled => { root.filters-changed(); } }
                                Chip { text: "light"; checked <=> root.f-light; toggled => { root.filters-changed(); } }
                                Chip { text: "dark"; checked <=> root.f-dark; toggled => { root.filters-changed(); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Chip { text: "standard"; checked <=> root.f-standard; toggled => { root.filters-changed(); } }
                                Chip { text: "mirrored"; checked <=> root.f-mirrored; toggled => { root.filters-changed(); } }
                                Chip { text: "system"; checked <=> root.f-system; toggled => { root.filters-changed(); } }
                                Chip { text: "user"; checked <=> root.f-user; toggled => { root.filters-changed(); } }
                            }
                        }

                        ListView {
                            for card[i] in root.cards: VerticalLayout {
                                padding-bottom: 6px;
                                ThemeRow {
                                    card: card;
                                    selected: root.selected == i;
                                    clicked => {
                                        root.selected = i;
                                        root.select(i);
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Skin.hairline;
                    }
                }

                // ---------------------------------------- right pane ---
                VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 20px;
                    padding-bottom: 22px;
                    spacing: 20px;

                    // Live preview
                    Rectangle {
                        min-height: 250px;
                        border-radius: 24px;
                        background: root.backdrop;
                        clip: true;

                        Image {
                            source: root.dots;
                            image-fit: preserve;
                            opacity: 0.9;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 18px;

                            HorizontalLayout {
                                alignment: center;
                                PreviewShape {
                                    source: root.sel-p0;
                                    present: root.sel-h0;
                                    box: Math.round(root.size * 1.9) * 1px;
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 22px;
                                PreviewShape { source: root.sel-p1; present: root.sel-h1; box: Math.round(root.size * 1.25) * 1px; }
                                PreviewShape { source: root.sel-p2; present: root.sel-h2; box: Math.round(root.size * 1.25) * 1px; }
                                PreviewShape { source: root.sel-p3; present: root.sel-h3; box: Math.round(root.size * 1.25) * 1px; }
                                PreviewShape { source: root.sel-p4; present: root.sel-h4; box: Math.round(root.size * 1.25) * 1px; }
                                PreviewShape { source: root.sel-p5; present: root.sel-h5; box: Math.round(root.size * 1.25) * 1px; }
                            }
                        }

                        Text {
                            x: 18px;
                            y: 16px;
                            text: "LIVE PREVIEW";
                            font-family: "Roboto Mono";
                            font-size: 11px;
                            letter-spacing: 0.6px;
                            color: Skin.a.primary;
                        }

                        // Backdrop control, kept from the previous UI.
                        HorizontalLayout {
                            x: parent.width - self.width - 16px;
                            y: 14px;
                            spacing: 4px;
                            for label[i] in ["dark", "light", "mid"]: Rectangle {
                                width: 44px;
                                height: 22px;
                                border-radius: 11px;
                                background: root.backdrop-mode == i ? Skin.a.primary
                                    : Skin.surface.with-alpha(0.55);
                                Text {
                                    text: label;
                                    font-size: 10px;
                                    font-weight: 500;
                                    color: root.backdrop-mode == i ? Skin.a.on-primary
                                        : Skin.on-surface-variant;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.backdrop-mode = i; }
                                }
                            }
                        }

                        Rectangle {
                            x: parent.width - self.width - 16px;
                            y: parent.height - self.height - 16px;
                            height: 26px;
                            border-radius: 12px;
                            background: Skin.a.primary;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text {
                                    text: Math.round(root.size) + " px";
                                    font-family: "Roboto Mono";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Skin.a.on-primary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Size
                    VerticalLayout {
                        spacing: 10px;

                        HorizontalLayout {
                            Text {
                                text: "Size";
                                font-size: 14px;
                                font-weight: 500;
                                color: Skin.on-surface;
                            }
                            Rectangle { }
                            Text {
                                text: "XCURSOR_SIZE";
                                font-family: "Roboto Mono";
                                font-size: 12px;
                                color: Skin.on-surface-variant;
                            }
                        }

                        Slider {
                            minimum: 16;
                            maximum: 96;
                            value <=> root.size;
                            released(v) => { root.size-changed(Math.round(v / 2) * 2); }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            for tick in [16, 24, 32, 48, 64, 96]: Tick {
                                value: tick;
                                current: Math.round(root.size) == tick;
                                clicked => {
                                    root.size = tick;
                                    root.size-changed(tick);
                                }
                            }
                        }
                    }

                    if root.stale-conf != "": Rectangle {
                        height: 28px;
                        border-radius: 8px;
                        background: Skin.a.container;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: "stale env = XCURSOR_* in " + root.stale-conf + " — inert since the Lua port";
                                font-size: 11px;
                                color: Skin.a.on-container;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    // Action row
                    HorizontalLayout {
                        spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.status-is-error ? root.status : root.command;
                                font-family: "Roboto Mono";
                                font-size: 11px;
                                color: root.status-is-error ? MaterialPalette.error
                                    : Skin.on-surface-variant;
                                overflow: elide;
                            }
                        }

                        Rectangle { }

                        TextButton {
                            text: "Reset";
                            enabled: root.can-revert;
                            clicked => { root.revert(); }
                        }

                        FilledButton {
                            text: "Apply";
                            enabled: root.selected >= 0;
                            clicked => { root.save(); }
                        }
                    }
                }
            }
        }

        // ------------------------------------------------ accent menu ---
        if root.menu-open: TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.menu-open = false; }
        }

        if root.menu-open: Rectangle {
            x: parent.width - self.width - 74px;
            y: 62px;
            width: 268px;
            height: menu.preferred-height;
            border-radius: 20px;
            background: Skin.container;
            drop-shadow-blur: 28px;
            drop-shadow-color: Skin.dark ? rgba(0, 0, 0, 0.7) : rgba(20, 14, 10, 0.3);
            drop-shadow-offset-y: 12px;

            menu := VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "Accent color";
                    font-size: 13px;
                    font-weight: 500;
                    color: Skin.on-surface;
                }

                // Six swatches, each split primary over primary-container.
                HorizontalLayout {
                    spacing: 10px;
                    for swatch[i] in Skin.dark ? Skin.dark-accents : Skin.light-accents: Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        clip: true;
                        border-width: root.accent == i ? 2px : 0;
                        border-color: Skin.on-surface;

                        accessible-role: button;
                        accessible-label: swatch.name;

                        VerticalLayout {
                            Rectangle { background: swatch.primary; }
                            Rectangle { background: swatch.container; }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.accent = i;
                                root.sync-skin();
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Skin.chip-border; }

                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Follow Omarchy theme";
                            font-size: 12px;
                            color: Skin.on-surface-variant;
                        }
                    }
                    Rectangle { }
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            checked <=> root.follow-theme;
                            checked-state-changed(on) => { root.follow-theme-changed(on); }
                        }
                    }
                }

                Text {
                    text: Skin.a.name + " · Material 3 tonal scheme";
                    font-size: 11px;
                    color: Skin.on-surface-variant;
                }
            }
        }
    }
}
